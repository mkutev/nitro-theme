{% liquid
  assign accessories = product.metafields.custom.recommended_accessories

  if accessories != nil and accessories.value != blank
    assign accessory_products = accessories.value
  else
    assign accessory_products = nil
  endif
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if accessory_products != nil %}
  <section class="section section--recommended-products section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient" aria-label="{{ section.settings.heading | escape }}">
    <div class="page-width">
      <div class="section-header">
        {% if section.settings.subheading != blank %}
          <p class="section-header__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section-header__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      <div class="grid grid--{{ section.settings.columns }}-col grid--{{ section.settings.columns_mobile }}-col-mobile">
        {% for accessory_product in accessory_products %}
          <div class="grid__item">
            {% render 'card-product',
              card_product: accessory_product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              section_id: section.id
            %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.recommended_accessories.name",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.recommended_accessories.settings.subheading.label",
      "default": "t:sections.recommended_accessories.settings.subheading.default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.recommended_accessories.settings.heading.label",
      "default": "t:sections.recommended_accessories.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.recommended_accessories.settings.columns.label",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.recommended_accessories.settings.columns_mobile.label",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.recommended_accessories.settings.image_ratio.label",
      "default": "square",
      "options": [
        { "value": "adapt", "label": "t:sections.recommended_accessories.settings.image_ratio.options.adapt" },
        { "value": "square", "label": "t:sections.recommended_accessories.settings.image_ratio.options.square" },
        { "value": "portrait", "label": "t:sections.recommended_accessories.settings.image_ratio.options.portrait" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.recommended_accessories.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.recommended_accessories.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.recommended_accessories.settings.show_rating.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    { 
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:product.recommended_accessories.name"
    }
  ]
}
{% endschema %}